<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>NutriScan</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>nutriscan</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>nutriscan</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleURLName</key>
			<string>google-oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GOOGLE_REVERSED_CLIENT_ID)</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Lets you point the app at a dev server on your LAN over plain http. -->
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>NutriScan uses the camera to photograph meals, receipts and menus for nutrition analysis.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>NutriScan lets you pick meal, receipt and menu photos to analyse.</string>
	<key>NSHealthShareUsageDescription</key>
	<string>NutriScan reads steps, active and resting energy, exercise minutes, distance, sleep, weight and resting heart rate to compare what you eat with what you burn.</string>
	<key>NSHealthUpdateUsageDescription</key>
	<string>NutriScan does not write to Apple Health.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Used only when you point NutriScan at a development server on your network.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.nutriscan.app.refresh</string>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>AccentColor</string>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>NSUserActivityTypes</key>
	<array/>
	<!-- Read by the app at runtime (see AppConfig.swift). -->
	<key>NutriScanAPIBaseURL</key>
	<string>$(API_BASE_URL)</string>
	<key>NutriScanGoogleClientID</key>
	<string>$(GOOGLE_IOS_CLIENT_ID)</string>
	<key>NutriScanGoogleReversedClientID</key>
	<string>$(GOOGLE_REVERSED_CLIENT_ID)</string>
</dict>
</plist>
